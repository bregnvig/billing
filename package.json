{
  "name": "billing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-billing --import=./.firebase-data --export-on-exit",
    "kill-ports": "npx kill-port --port 4100,4410,4510,5101,8180,9199",
    "functions:watch": "npm --prefix functions run build:watch",
    "functions:test": "npm --prefix functions test",
    "test:e2e": "npm --prefix functions run build && firebase emulators:exec --config firebase.e2e.json --project demo-billing ./e2e/hook-e2e.sh"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "firebase": "^13.2.0",
    "material-symbols": "^0.48.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "firebase-tools": "^15.35.0",
    "jsdom": "^30.0.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
