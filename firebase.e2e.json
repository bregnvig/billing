{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 19199
    },
    "functions": {
      "port": 15101
    },
    "firestore": {
      "port": 18180,
      "websocketPort": 19150
    },
    "hub": {
      "port": 14410
    },
    "logging": {
      "port": 14510
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", "src", "*.log", ".env.local", "vitest.config.ts", "tsconfig.json"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ]
}
