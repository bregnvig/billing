rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner's verified Google account. Keep in sync with `allowedEmail` in
    // src/app/firebase/firebase.config.ts and OWNER_EMAIL in functions/.env.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'flemming@loopme.dk'
        && request.auth.token.email_verified == true;
    }

    // Collection names: model/collections.ts. No catch-all match on purpose: rules are
    // OR-ed, so a `{document=**}` match would also open the server-only collections below.

    match /projects/{id} {
      allow read, write: if isOwner();
    }
    match /tasks/{id} {
      allow read, write: if isOwner();
    }
    match /timeEntries/{id} {
      allow read, write: if isOwner();
    }

    // Written only by Cloud Functions (createDevice / revokeDevice / reportEvent).
    match /devices/{id} {
      allow read: if isOwner();
    }
    match /hookEvents/{id} {
      allow read: if isOwner();
    }

    // Token hashes: Cloud Functions only. Not even the owner can read them.
    match /deviceTokens/{id} {
      allow read, write: if false;
    }
  }
}
